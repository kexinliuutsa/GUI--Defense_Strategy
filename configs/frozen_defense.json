{
  "version": "frozen_v1",
  "description": "Frozen operating configuration for the cross-scale behavioral defense.",

  "primary_operating_point": {
    "minimum_observed_actions": 4,
    "target_human_fpr": 0.025
  },

  "thresholds": {
    "session_distribution_head": 0.8703146248159933,
    "strict_cross_action_head": 0.9768090920254805,
    "human_reference_head": 1.1488039406123078
  },

  "decision_rule": {
    "base_detection": [
      "session_distribution_head",
      "strict_cross_action_head",
      "fake_action_artifact_head"
    ],
    "base_combination": "OR",
    "human_reference_mode": "conditional_on_base_miss",
    "final_combination": "base_detection OR conditional_human_reference"
  },

  "training_policy": {
    "source_head_training_data": [
      "Human",
      "Raw Agent"
    ],
    "human_reference_training_data": [
      "Human"
    ],
    "humanization_conditions_used_for_training": false,
    "humanization_conditions_used_for_threshold_tuning": false
  },

  "evaluation_policy": {
    "primary_rolling_start_action": 4,
    "human_evaluation": "participant-disjoint out-of-fold",
    "attack_evaluation": "frozen detector",
    "task_clusters": [
      "Social Media",
      "Shopping",
      "Video Streaming",
      "Trip Planning",
      "Office & Learning"
    ]
  },

  "known_scope_limits": {
    "fake_interval_exact_component_comparison": false,
    "fake_interval_reason": "Current offline replay uses a coordinate-materialized proxy.",
    "fully_adaptive_attacker_evaluated": false
  }
}
