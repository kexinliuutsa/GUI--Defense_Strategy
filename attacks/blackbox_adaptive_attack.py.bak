from __future__ import annotations

from dataclasses import dataclass, asdict
from typing import Any, Callable
import copy
import json
import math

import numpy as np


Session = list[list[Any]]
Oracle = Callable[[Session], bool]

FAMILIES = (
    "timing",
    "spatial_low",
    "spatial_high",
    "heterogeneous",
    "mixed",
)


@dataclass(frozen=True)
class MutationSpec:
    family: str
    spatial_amp_px: float
    spatial_freq: int
    duration_scale: float
    gap_scale: float
    timing_jitter: float
    heterogeneity: float


@dataclass
class AttackResult:
    escaped: bool
    queries_used: int
    queries_to_first_escape: int | None
    best_family: str | None
    spatial_rms_px: float | None
    endpoint_shift_px: float | None
    duration_cost: float | None
    gap_cost: float | None
    family_queries: dict[str, int]
    family_successes: dict[str, int]
    best_spec: MutationSpec | None

    def to_dict(self):
        d = asdict(self)

        spec = d.pop("best_spec")

        d["family_queries"] = json.dumps(
            d["family_queries"],
            sort_keys=True,
        )

        d["family_successes"] = json.dumps(
            d["family_successes"],
            sort_keys=True,
        )

        if spec is not None:
            for k, v in spec.items():
                d[f"spec_{k}"] = v

        return d


def _clone_event(event, timestamp_us, x, y):
    """
    Clone an AHB-style FingerEvent without importing
    anything from the defense.
    """

    t = int(round(timestamp_us))
    xx = int(round(x))
    yy = int(round(y))

    # NamedTuple-like event
    if hasattr(event, "_replace"):
        try:
            return event._replace(
                timestamp_us=t,
                x=xx,
                y=yy,
            )
        except Exception:
            pass

    # Mutable object / dataclass
    cloned = copy.copy(event)

    try:
        cloned.timestamp_us = t
        cloned.x = xx
        cloned.y = yy
        return cloned
    except Exception:
        pass

    # Constructor fallbacks
    cls = type(event)

    try:
        return cls(
            timestamp_us=t,
            x=xx,
            y=yy,
        )
    except Exception:
        pass

    try:
        return cls(t, xx, yy)
    except Exception:
        pass

    raise TypeError(
        f"Cannot rebuild event type {cls.__name__}. "
        "Adapt _clone_event() to the AHB FingerEvent constructor."
    )


def _log_uniform(rng, low, high):
    return float(
        np.exp(
            rng.uniform(
                np.log(low),
                np.log(high),
            )
        )
    )


def _heterogeneity_multiplier(
    rng,
    amount,
):
    if amount <= 0:
        return 1.0

    z = rng.normal(
        0.0,
        amount,
    )

    z = np.clip(
        z,
        -0.8,
        0.8,
    )

    return float(
        np.exp(z)
    )


def sample_spec(
    family,
    rng,
):

    if family == "timing":
        return MutationSpec(
            family=family,
            spatial_amp_px=0.0,
            spatial_freq=1,
            duration_scale=_log_uniform(
                rng,
                0.55,
                1.80,
            ),
            gap_scale=_log_uniform(
                rng,
                0.55,
                1.80,
            ),
            timing_jitter=float(
                rng.uniform(
                    0.03,
                    0.35,
                )
            ),
            heterogeneity=float(
                rng.uniform(
                    0.05,
                    0.35,
                )
            ),
        )

    if family == "spatial_low":
        return MutationSpec(
            family=family,
            spatial_amp_px=float(
                rng.uniform(
                    0.5,
                    6.0,
                )
            ),
            spatial_freq=int(
                rng.choice(
                    [1, 2, 3, 4]
                )
            ),
            duration_scale=_log_uniform(
                rng,
                0.90,
                1.10,
            ),
            gap_scale=_log_uniform(
                rng,
                0.90,
                1.10,
            ),
            timing_jitter=float(
                rng.uniform(
                    0.0,
                    0.05,
                )
            ),
            heterogeneity=float(
                rng.uniform(
                    0.03,
                    0.15,
                )
            ),
        )

    if family == "spatial_high":
        return MutationSpec(
            family=family,
            spatial_amp_px=float(
                rng.uniform(
                    0.5,
                    6.0,
                )
            ),
            spatial_freq=int(
                rng.choice(
                    [4, 6, 8, 12, 16]
                )
            ),
            duration_scale=_log_uniform(
                rng,
                0.90,
                1.10,
            ),
            gap_scale=_log_uniform(
                rng,
                0.90,
                1.10,
            ),
            timing_jitter=float(
                rng.uniform(
                    0.0,
                    0.05,
                )
            ),
            heterogeneity=float(
                rng.uniform(
                    0.03,
                    0.15,
                )
            ),
        )

    if family == "heterogeneous":
        return MutationSpec(
            family=family,
            spatial_amp_px=float(
                rng.uniform(
                    0.5,
                    5.0,
                )
            ),
            spatial_freq=int(
                rng.choice(
                    [1, 2, 4, 6, 8, 12]
                )
            ),
            duration_scale=_log_uniform(
                rng,
                0.70,
                1.40,
            ),
            gap_scale=_log_uniform(
                rng,
                0.70,
                1.40,
            ),
            timing_jitter=float(
                rng.uniform(
                    0.05,
                    0.25,
                )
            ),
            heterogeneity=float(
                rng.uniform(
                    0.25,
                    0.55,
                )
            ),
        )

    if family == "mixed":
        return MutationSpec(
            family=family,
            spatial_amp_px=float(
                rng.uniform(
                    1.0,
                    10.0,
                )
            ),
            spatial_freq=int(
                rng.choice(
                    [1, 2, 4, 6, 8, 12, 16]
                )
            ),
            duration_scale=_log_uniform(
                rng,
                0.60,
                1.70,
            ),
            gap_scale=_log_uniform(
                rng,
                0.60,
                1.70,
            ),
            timing_jitter=float(
                rng.uniform(
                    0.05,
                    0.35,
                )
            ),
            heterogeneity=float(
                rng.uniform(
                    0.10,
                    0.45,
                )
            ),
        )

    raise ValueError(
        f"Unknown mutation family: {family}"
    )


def mutate_session(
    session,
    spec,
    rng,
):
    """
    Black-box mutation space.

    Constraints:
    - same number of actions
    - same number of events
    - swipe endpoints unchanged
    - taps not spatially relocated
    - no fake-action insertion
    - no action deletion
    """

    output = []

    previous_original_end = None
    previous_new_end = None

    for gesture in session:

        if not gesture:
            output.append([])
            continue

        timestamps = np.asarray(
            [
                float(e.timestamp_us)
                for e in gesture
            ],
            dtype=float,
        )

        coordinates = np.asarray(
            [
                [
                    float(e.x),
                    float(e.y),
                ]
                for e in gesture
            ],
            dtype=float,
        )

        new_coordinates = (
            coordinates.copy()
        )

        # --------------------------------------------
        # Spatial mutation
        # --------------------------------------------

        # Avoid spatial relocation of tap-like
        # few-event gestures.
        if (
            len(gesture) >= 5
            and spec.spatial_amp_px > 0
        ):

            direction = (
                coordinates[-1]
                - coordinates[0]
            )

            direction_norm = float(
                np.linalg.norm(
                    direction
                )
            )

            if direction_norm > 1e-9:

                perpendicular = np.asarray(
                    [
                        -direction[1],
                        direction[0],
                    ],
                    dtype=float,
                )

                perpendicular /= (
                    direction_norm
                )

            else:

                angle = float(
                    rng.uniform(
                        0.0,
                        2.0 * math.pi,
                    )
                )

                perpendicular = np.asarray(
                    [
                        math.cos(angle),
                        math.sin(angle),
                    ],
                    dtype=float,
                )

            action_amplitude = (
                spec.spatial_amp_px
                * _heterogeneity_multiplier(
                    rng,
                    spec.heterogeneity,
                )
            )

            u = np.linspace(
                0.0,
                1.0,
                len(gesture),
            )

            phase = float(
                rng.uniform(
                    0.0,
                    2.0 * math.pi,
                )
            )

            # Zero at both endpoints.
            envelope = np.sin(
                math.pi * u
            )

            wave = np.sin(
                2.0
                * math.pi
                * spec.spatial_freq
                * u
                + phase
            )

            offsets = (
                action_amplitude
                * envelope
                * wave
            )

            new_coordinates += (
                offsets[:, None]
                * perpendicular[None, :]
            )

            # Preserve endpoints exactly.
            new_coordinates[0] = (
                coordinates[0]
            )

            new_coordinates[-1] = (
                coordinates[-1]
            )

        # --------------------------------------------
        # Timing mutation
        # --------------------------------------------

        original_start = float(
            timestamps[0]
        )

        original_end = float(
            timestamps[-1]
        )

        original_duration = max(
            1.0,
            original_end
            - original_start,
        )

        duration_multiplier = (
            spec.duration_scale
            * _heterogeneity_multiplier(
                rng,
                spec.heterogeneity,
            )
        )

        duration_multiplier = float(
            np.clip(
                duration_multiplier,
                0.35,
                2.50,
            )
        )

        new_duration = max(
            1000.0,
            original_duration
            * duration_multiplier,
        )

        if previous_new_end is None:

            new_start = (
                original_start
            )

        else:

            original_gap = max(
                0.0,
                original_start
                - float(
                    previous_original_end
                ),
            )

            gap_multiplier = (
                spec.gap_scale
                * _heterogeneity_multiplier(
                    rng,
                    spec.heterogeneity,
                )
            )

            jitter_sigma = (
                spec.timing_jitter
                * max(
                    original_gap,
                    100_000.0,
                )
            )

            jitter = float(
                rng.normal(
                    0.0,
                    jitter_sigma,
                )
            )

            new_gap = max(
                0.0,
                original_gap
                * gap_multiplier
                + jitter,
            )

            new_start = (
                float(
                    previous_new_end
                )
                + new_gap
            )

        if len(gesture) == 1:

            relative_time = (
                np.zeros(
                    1,
                    dtype=float,
                )
            )

        else:

            relative_time = (
                timestamps
                - original_start
            ) / original_duration

            relative_time = np.clip(
                relative_time,
                0.0,
                1.0,
            )

            relative_time = (
                np.maximum.accumulate(
                    relative_time
                )
            )

        new_timestamps = (
            new_start
            + relative_time
            * new_duration
        )

        if len(new_timestamps) > 1:

            new_timestamps[0] = (
                new_start
            )

            new_timestamps[-1] = (
                new_start
                + new_duration
            )

        new_gesture = []

        for event, t, xy in zip(
            gesture,
            new_timestamps,
            new_coordinates,
        ):

            new_gesture.append(
                _clone_event(
                    event,
                    t,
                    xy[0],
                    xy[1],
                )
            )

        output.append(
            new_gesture
        )

        previous_original_end = (
            original_end
        )

        previous_new_end = float(
            new_timestamps[-1]
        )

    return output


def _duration_gap_arrays(
    session,
):

    durations = []
    gaps = []

    previous_end = None

    for gesture in session:

        if not gesture:
            continue

        start = float(
            gesture[0].timestamp_us
        )

        end = float(
            gesture[-1].timestamp_us
        )

        durations.append(
            max(
                0.0,
                end - start,
            )
        )

        if previous_end is not None:

            gaps.append(
                max(
                    0.0,
                    start
                    - previous_end,
                )
            )

        previous_end = end

    return (
        np.asarray(
            durations,
            dtype=float,
        ),
        np.asarray(
            gaps,
            dtype=float,
        ),
    )


def perturbation_metrics(
    original,
    attacked,
):

    squared_distance = []
    endpoint_shift = []

    for original_gesture, attacked_gesture in zip(
        original,
        attacked,
    ):

        if (
            len(original_gesture)
            != len(attacked_gesture)
        ):
            raise ValueError(
                "Gesture event count changed."
            )

        if not original_gesture:
            continue

        for original_event, attacked_event in zip(
            original_gesture,
            attacked_gesture,
        ):

            dx = (
                float(attacked_event.x)
                - float(original_event.x)
            )

            dy = (
                float(attacked_event.y)
                - float(original_event.y)
            )

            squared_distance.append(
                dx * dx + dy * dy
            )

        for index in (
            0,
            -1,
        ):

            endpoint_shift.append(
                math.hypot(
                    float(
                        attacked_gesture[
                            index
                        ].x
                    )
                    - float(
                        original_gesture[
                            index
                        ].x
                    ),
                    float(
                        attacked_gesture[
                            index
                        ].y
                    )
                    - float(
                        original_gesture[
                            index
                        ].y
                    ),
                )
            )

    if squared_distance:

        spatial_rms = math.sqrt(
            float(
                np.mean(
                    squared_distance
                )
            )
        )

    else:
        spatial_rms = 0.0

    maximum_endpoint_shift = (
        max(endpoint_shift)
        if endpoint_shift
        else 0.0
    )

    durations_original, gaps_original = (
        _duration_gap_arrays(
            original
        )
    )

    durations_attacked, gaps_attacked = (
        _duration_gap_arrays(
            attacked
        )
    )

    if len(durations_original):

        duration_cost = float(
            np.mean(
                np.abs(
                    np.log(
                        (
                            durations_attacked
                            + 1000.0
                        )
                        /
                        (
                            durations_original
                            + 1000.0
                        )
                    )
                )
            )
        )

    else:
        duration_cost = 0.0

    if len(gaps_original):

        gap_cost = float(
            np.mean(
                np.abs(
                    np.log1p(
                        gaps_attacked
                        / 1_000_000.0
                    )
                    -
                    np.log1p(
                        gaps_original
                        / 1_000_000.0
                    )
                )
            )
        )

    else:
        gap_cost = 0.0

    return {
        "spatial_rms_px":
            spatial_rms,

        "endpoint_shift_px":
            maximum_endpoint_shift,

        "duration_cost":
            duration_cost,

        "gap_cost":
            gap_cost,

        "search_cost":
            spatial_rms / 10.0
            + duration_cost
            + gap_cost,
    }


def blend_sessions(
    original,
    adversarial,
    lam,
):

    lam = float(
        np.clip(
            lam,
            0.0,
            1.0,
        )
    )

    output = []

    for original_gesture, adversarial_gesture in zip(
        original,
        adversarial,
    ):

        if (
            len(original_gesture)
            != len(adversarial_gesture)
        ):
            raise ValueError(
                "Gesture event count changed."
            )

        new_gesture = []
        previous_t = None

        for original_event, adversarial_event in zip(
            original_gesture,
            adversarial_gesture,
        ):

            t = (
                (1.0 - lam)
                * float(
                    original_event.timestamp_us
                )
                +
                lam
                * float(
                    adversarial_event.timestamp_us
                )
            )

            x = (
                (1.0 - lam)
                * float(
                    original_event.x
                )
                +
                lam
                * float(
                    adversarial_event.x
                )
            )

            y = (
                (1.0 - lam)
                * float(
                    original_event.y
                )
                +
                lam
                * float(
                    adversarial_event.y
                )
            )

            if previous_t is not None:
                t = max(
                    t,
                    previous_t,
                )

            new_event = (
                _clone_event(
                    original_event,
                    t,
                    x,
                    y,
                )
            )

            new_gesture.append(
                new_event
            )

            previous_t = float(
                new_event.timestamp_us
            )

        output.append(
            new_gesture
        )

    return output


def _query(
    oracle,
    session,
):

    verdict = oracle(
        session
    )

    if isinstance(
        verdict,
        np.bool_,
    ):
        verdict = bool(
            verdict
        )

    if not isinstance(
        verdict,
        bool,
    ):
        raise TypeError(
            "Oracle must return only bool: "
            "True=detected, False=escaped."
        )

    return verdict


def _choose_family(
    rng,
    stats,
    strategy,
):

    if strategy == "uniform":

        return str(
            rng.choice(
                FAMILIES
            )
        )

    if strategy != "adaptive":

        raise ValueError(
            "strategy must be adaptive or uniform"
        )

    # Thompson sampling.
    # Only binary query feedback is used.
    samples = {}

    for family in FAMILIES:

        samples[family] = float(
            rng.beta(
                stats[family][
                    "success"
                ]
                + 1,
                stats[family][
                    "failure"
                ]
                + 1,
            )
        )

    return max(
        samples,
        key=samples.get,
    )


def attack_session(
    session,
    oracle,
    *,
    budget=100,
    refine_queries=20,
    seed=20260827,
    strategy="adaptive",
):
    """
    Label-only black-box adaptive attack.

    The attacker sees ONLY:

        oracle(session) -> bool

    True  = detected
    False = escaped

    It never receives component scores,
    features, thresholds, model weights,
    or Human-reference information.
    """

    rng = np.random.default_rng(
        seed
    )

    initial_detected = _query(
        oracle,
        session,
    )

    if not initial_detected:
        raise ValueError(
            "Input session already escapes. "
            "Use only currently detected sessions."
        )

    stats = {
        family: {
            "queries": 0,
            "success": 0,
            "failure": 0,
        }
        for family in FAMILIES
    }

    queries_used = 0

    first_escape_query = None

    best_session = None
    best_spec = None
    best_metrics = None

    search_limit = min(
        budget,
        max(
            len(FAMILIES),
            budget
            - max(
                0,
                refine_queries,
            ),
        ),
    )

    # --------------------------------------------
    # Search
    # --------------------------------------------

    while queries_used < search_limit:

        # Force one query from each family first.
        if queries_used < len(
            FAMILIES
        ):

            family = FAMILIES[
                queries_used
            ]

        else:

            family = _choose_family(
                rng,
                stats,
                strategy,
            )

        spec = sample_spec(
            family,
            rng,
        )

        candidate = mutate_session(
            session,
            spec,
            rng,
        )

        detected = _query(
            oracle,
            candidate,
        )

        queries_used += 1

        stats[family][
            "queries"
        ] += 1

        if detected:

            stats[family][
                "failure"
            ] += 1

            continue

        stats[family][
            "success"
        ] += 1

        if first_escape_query is None:

            first_escape_query = (
                queries_used
            )

        metrics = (
            perturbation_metrics(
                session,
                candidate,
            )
        )

        if (
            best_metrics is None
            or
            metrics["search_cost"]
            <
            best_metrics[
                "search_cost"
            ]
        ):

            best_session = (
                candidate
            )

            best_spec = spec

            best_metrics = (
                metrics
            )

    # --------------------------------------------
    # Boundary refinement
    # --------------------------------------------

    if (
        best_session is not None
        and queries_used < budget
    ):

        anchor = (
            best_session
        )

        low = 0.0
        high = 1.0

        refined_best = (
            anchor
        )

        while queries_used < budget:

            middle = (
                low + high
            ) / 2.0

            candidate = (
                blend_sessions(
                    session,
                    anchor,
                    middle,
                )
            )

            detected = _query(
                oracle,
                candidate,
            )

            queries_used += 1

            if detected:

                low = middle

            else:

                high = middle
                refined_best = (
                    candidate
                )

        best_session = (
            refined_best
        )

        best_metrics = (
            perturbation_metrics(
                session,
                best_session,
            )
        )

    # --------------------------------------------
    # Failure
    # --------------------------------------------

    if best_session is None:

        result = AttackResult(
            escaped=False,
            queries_used=queries_used,
            queries_to_first_escape=None,
            best_family=None,
            spatial_rms_px=None,
            endpoint_shift_px=None,
            duration_cost=None,
            gap_cost=None,

            family_queries={
                family:
                    stats[family][
                        "queries"
                    ]
                for family
                in FAMILIES
            },

            family_successes={
                family:
                    stats[family][
                        "success"
                    ]
                for family
                in FAMILIES
            },

            best_spec=None,
        )

        return (
            result,
            None,
        )

    # --------------------------------------------
    # Success
    # --------------------------------------------

    result = AttackResult(
        escaped=True,

        queries_used=(
            queries_used
        ),

        queries_to_first_escape=(
            first_escape_query
        ),

        best_family=(
            best_spec.family
        ),

        spatial_rms_px=(
            best_metrics[
                "spatial_rms_px"
            ]
        ),

        endpoint_shift_px=(
            best_metrics[
                "endpoint_shift_px"
            ]
        ),

        duration_cost=(
            best_metrics[
                "duration_cost"
            ]
        ),

        gap_cost=(
            best_metrics[
                "gap_cost"
            ]
        ),

        family_queries={
            family:
                stats[family][
                    "queries"
                ]
            for family
            in FAMILIES
        },

        family_successes={
            family:
                stats[family][
                    "success"
                ]
            for family
            in FAMILIES
        },

        best_spec=(
            best_spec
        ),
    )

    return (
        result,
        best_session,
    )